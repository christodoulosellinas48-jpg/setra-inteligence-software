{
  "name": "AuditPack",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Reference to the business"
    },
    "year": {
      "type": "number",
      "description": "Financial year"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ],
      "default": "draft"
    },
    "pack_url": {
      "type": "string",
      "description": "URL to generated ZIP/PDF bundle"
    },
    "generated_by": {
      "type": "string",
      "description": "User email"
    }
  },
  "required": [
    "business_id",
    "year"
  ]
}